---
import leaf from '@phosphor-icons/core/assets/regular/leaf.svg?raw';
import search from '@phosphor-icons/core/assets/regular/magnifying-glass.svg?raw';
import moon from '@phosphor-icons/core/assets/regular/moon.svg?raw';
import sun from '@phosphor-icons/core/assets/regular/sun.svg?raw';
import arrow from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import right from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import left from '@phosphor-icons/core/assets/regular/arrow-left.svg?raw';
import rss from '@phosphor-icons/core/assets/regular/rss-simple.svg?raw';
import github from '@phosphor-icons/core/assets/regular/github-logo.svg?raw';
import close from '@phosphor-icons/core/assets/regular/x.svg?raw';
import mail from '@phosphor-icons/core/assets/regular/envelope-simple.svg?raw';
const icons = { leaf, search, moon, sun, arrow, right, left, rss, github, close, mail };
interface Props { name: keyof typeof icons; class?: string; }
const { name, class: className = '' } = Astro.props;
---
<span class:list={['icon', className]} aria-hidden="true" set:html={icons[name]} />
