{
  "name": "personal-notebook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "dev:status": "ASTRO_TELEMETRY_DISABLED=1 astro dev status",
    "dev:stop": "ASTRO_TELEMETRY_DISABLED=1 astro dev stop",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "new:post": "node scripts/new-post.mjs"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3"
  }
}
